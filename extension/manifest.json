{
  "manifest_version": 3,
  "name": "PHP Simple Check",
  "short_name": "PHP Check",
  "version": "1.1.0",
  "description": "読み込んだサイトのレスポンスヘッダー・Cookie・DOM から、PHP が使われているかを簡易判定します（🔴 PHP / 🟢 非 PHP）。",
  "minimum_chrome_version": "111",
  "permissions": ["webRequest", "cookies", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PHP Simple Check",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/detector.js", "lib/collect-dom.js", "lib/overlay.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
